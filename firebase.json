{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/list-invite/**", "destination": "/list-invite/index.html" },
      { "source": "/p/**", "run": { "serviceId": "sharepreview", "region": "us-central1" } },
      { "source": "/place/**", "run": { "serviceId": "sharepreview", "region": "us-central1" } },
      { "source": "/event/**", "run": { "serviceId": "sharepreview", "region": "us-central1" } },
      { "source": "/u/**", "run": { "serviceId": "sharepreview", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  }
}
